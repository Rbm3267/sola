  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .c-kw  { color: #c084fc; }
    :root:not([data-theme="light"]) .c-fn  { color: #34d399; }
    :root:not([data-theme="light"]) .c-str { color: #fbbf24; }
    :root:not([data-theme="light"]) .c-num { color: #60a5fa; }
    :root:not([data-theme="light"]) .c-tag { color: #c084fc; }
    :root:not([data-theme="light"]) .c-attr{ color: #60a5fa; }
    :root:not([data-theme="light"]) .c-sel { color: #f472b6; }
    :root:not([data-theme="light"]) .c-prop{ color: #60a5fa; }
    :root:not([data-theme="light"]) code { background: rgba(16,185,129,0.12); color: #34d399; }
  }
  :root[data-theme="dark"] .c-kw  { color: #c084fc; }
  :root[data-theme="dark"] .c-fn  { color: #34d399; }
  :root[data-theme="dark"] .c-str { color: #fbbf24; }
  :root[data-theme="dark"] .c-num { color: #60a5fa; }
  :root[data-theme="dark"] .c-tag { color: #c084fc; }
  :root[data-theme="dark"] .c-attr{ color: #60a5fa; }
  :root[data-theme="dark"] .c-sel { color: #f472b6; }
  :root[data-theme="dark"] .c-prop{ color: #60a5fa; }
  :root[data-theme="dark"] code   { background: rgba(16,185,129,0.12); color: #34d399; }

  @media (max-width: 768px) {
    .sd-root { flex-direction: column; }
    .sd-sidebar { width: 100%; height: auto; position: static; border-right: none; border-bottom: 1px solid var(--sd-border, rgba(0,0,0,0.07)); }
    .sd-sidebar-inner { display: flex; flex-wrap: wrap; gap: 4px; padding: 12px; }
    .sd-nav-group-label { display: none; }
    .sd-content { padding: 32px 20px 60px; max-width: 100%; }
    .sd-feature-grid { grid-template-columns: 1fr; }
  }
</style>
