    font-family: ui-monospace, "SF Mono", "Cascadia Code", monospace;
    font-size: 13px;
    color: var(--sd-body, #374151);
  }
  .sd-code-block code { font-family: inherit; }

  /* Syntax highlight tokens */
  .c-kw  { color: #7c3aed; }
  .c-fn  { color: #059669; }
  .c-str { color: #d97706; }
  .c-num { color: #2563eb; }
  .c-tag { color: #7c3aed; }
  .c-attr{ color: #2563eb; }
  .c-comment { color: #9ca3af; font-style: italic; }
  .c-sel  { color: #db2777; }
  .c-prop { color: #2563eb; }

  /* Inline code */
  code {
    background: var(--sd-inline-code-bg, rgba(16,185,129,0.08));
