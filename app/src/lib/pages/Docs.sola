    padding: 2px 6px;
    border-radius: 5px;
    font-family: ui-monospace, "SF Mono", monospace;
    font-size: 12.5px;
  }
  pre code { background: none; color: inherit; padding: 0; border-radius: 0; }

  /* ---- Feature grid ---- */
  .sd-feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin: 24px 0 32px;
  }
  .sd-feature-card {
    border: 1px solid var(--sd-border, rgba(0,0,0,0.07));
