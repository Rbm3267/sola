    font-size: 13px;
    color: var(--sd-subtle, #6b7280);
    line-height: 1.6;
    margin: 0;
  }

  /* ---- Tables ---- */
  .sd-table-wrap { overflow-x: auto; margin: 16px 0 28px; border-radius: 10px; border: 1px solid var(--sd-border, rgba(0,0,0,0.08)); }
  .sd-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    background: var(--sd-surface, #fff);
  }
  .sd-table thead tr { background: var(--sd-code-head, #f3f4f6); }
  .sd-table th {
    text-align: left;
    padding: 10px 16px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--sd-muted, #9ca3af);
    font-family: ui-monospace, "SF Mono", monospace;
    border-bottom: 1px solid var(--sd-border, rgba(0,0,0,0.08));
  }
  .sd-table td {
    padding: 10px 16px;
    color: var(--sd-body, #374151);
    border-bottom: 1px solid var(--sd-border, rgba(0,0,0,0.05));
  }
  .sd-table tr:last-child td { border-bottom: none; }

  /* ---- Rule list ---- */
  .sd-rule-list { margin: 16px 0 28px; display: flex; flex-direction: column; gap: 10px; }
  .sd-rule { display: flex; gap: 12px; align-items: flex-start; }
  .sd-rule-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin-top: 5px; }
  .sd-rule-dot--green { background: #10b981; }
  .sd-rule-dot--amber { background: #f59e0b; }
  .sd-rule-dot--red   { background: #ef4444; }
  .sd-rule p { font-size: 14px; color: var(--sd-body, #374151); line-height: 1.65; margin: 0; }

  /* ---- Pipeline ---- */
  .sd-pipeline { display: flex; flex-direction: column; gap: 0; margin: 20px 0 32px; border: 1px solid var(--sd-border, rgba(0,0,0,0.08)); border-radius: 12px; overflow: hidden; }
  .sd-pipeline-step { display: flex; gap: 20px; padding: 20px 24px; background: var(--sd-surface, #fff); border-bottom: 1px solid var(--sd-border, rgba(0,0,0,0.06)); align-items: flex-start; }
  .sd-pipeline-step:last-child { border-bottom: none; }
  .sd-step-num {
    font-size: 11px; font-weight: 800; font-family: ui-monospace, "SF Mono", monospace;
    color: #10b981; background: rgba(16,185,129,0.1); padding: 3px 8px;
    border-radius: 6px; flex-shrink: 0; margin-top: 2px; letter-spacing: 0.04em;
  }
  .sd-pipeline-step strong { font-size: 14px; font-weight: 700; color: var(--sd-text, #111827); display: block; margin-bottom: 4px; }
  .sd-pipeline-step p { font-size: 13px; color: var(--sd-subtle, #6b7280); line-height: 1.6; margin: 0; }

  /* ---- Dark mode ---- */
  @media (prefers-color-scheme: dark) {
