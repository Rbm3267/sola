    justify-content: space-between;
    transition: all 0.2s ease;
  }
  .sola-card:hover {
    border-color: rgba(16, 185, 129, 0.3);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }
  .sola-card.col-2 {
    grid-column: span 2;
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .card-label {
    font-size: 10px;
    font-weight: 700;
    font-family: monospace;
    color: #64748b;
    letter-spacing: 0.08em;
  }
  .card-delta {
    font-size: 10px;
    font-family: monospace;
