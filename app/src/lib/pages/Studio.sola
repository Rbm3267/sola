<script>
  let activeTab = $state("dashboard");
  let promptText = $state("");
  let nodeCount = $state(5);
  let statusText = $state("Nominal");

  function triggerSignal() {
    nodeCount++;
    statusText = "Mesh Synced (" + nodeCount + ")";
  }
</script>

<div class="sola-studio-root">
  <div class="studio-topbar">
    <div class="studio-brand">
      <div class="studio-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect x="3" y="3" width="18" height="18" rx="3"/>
          <line x1="3" y1="9" x2="21" y2="9"/>
          <line x1="9" y1="21" x2="9" y2="9"/>
        </svg>
      </div>
      <div class="studio-title-wrap">
        <h1 class="studio-title">Sola Studio</h1>
        <span class="studio-badge">Native .sola Canvas</span>
      </div>
    </div>

    <div class="studio-actions">
      <button class="studio-btn studio-btn-primary" onclick={triggerSignal}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        <span>Inject Signal ({nodeCount})</span>
      </button>
    </div>
  </div>

  <div class="studio-canvas">
    <div class="studio-grid">
      <!-- Card 1: Metric Tile -->
      <div class="sola-card col-1">
        <div class="card-header">
          <span class="card-label">INGESTION THROUGHPUT</span>
          <span class="card-delta">+18.4%</span>
        </div>
        <div class="card-value">$148,200</div>
        <div class="card-meta">Bound to one signal, written directly</div>
      </div>

      <!-- Card 2: Status HUD -->
      <div class="sola-card col-1">
        <div class="card-header">
          <span class="card-label">CLUSTER STATE</span>
          <span class="card-badge-live">Live</span>
        </div>
        <div class="card-value card-val-emerald">{statusText}</div>
        <div class="card-meta">{nodeCount} Active Telemetry Nodes</div>
      </div>

      <!-- Card 3: Dial Controller -->
      <div class="sola-card col-1">
        <div class="card-header">
          <span class="card-label">MESH NODES</span>
          <span class="card-delta">live</span>
        </div>
        <div class="card-value">{nodeCount}</div>
        <div class="card-meta">Direct DOM writes</div>
      </div>

      <!-- Card 4: Signal Stream Waterfall -->
      <div class="sola-card col-2">
        <div class="card-header">
          <span class="card-label">TELEMETRY STREAM CASCADE</span>
          <span class="card-delta">Live</span>
        </div>
        <div class="spark-bars">
          <div class="bar" style="height: 40%;"></div>
          <div class="bar" style="height: 65%;"></div>
          <div class="bar" style="height: 35%;"></div>
          <div class="bar" style="height: 85%;"></div>
          <div class="bar" style="height: 55%;"></div>
          <div class="bar" style="height: 95%;"></div>
          <div class="bar" style="height: 75%;"></div>
          <div class="bar" style="height: 90%;"></div>
        </div>
        <div class="card-meta">Direct text node mutation without virtual DOM tree reconciliation</div>
      </div>

      <!-- Card 5: Pipeline Code Block -->
      <div class="sola-card col-1">
        <div class="card-header">
          <span class="card-label">SIGNAL RUNTIME</span>
          <span class="card-badge-live">@sola-air-ui/core</span>
        </div>
        <div class="code-preview">
          <code>const count = $state(0);<br/>count.subscribe(val => patch(val));</code>
        </div>
        <div class="card-meta">Single-file .sola compilation</div>
      </div>
    </div>
  </div>
</div>

<style>
  .sola-studio-root {
    width: 100%;
    min-height: calc(100vh - 64px);
    background: #090d19;
    color: #f8fafc;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: flex;
    flex-direction: column;
  }
  .studio-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    background: rgba(9, 13, 25, 0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
