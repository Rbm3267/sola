  }
  .card-val-emerald {
    color: #10b981;
  }
  .card-meta {
    font-size: 11px;
    color: #94a3b8;
  }
  .spark-bars {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 60px;
    margin: 12px 0;
  }
  .bar {
    flex: 1;
    background: rgba(16, 185, 129, 0.3);
    border-radius: 4px;
    transition: all 0.2s ease;
  }
  .bar:hover {
    background: #10b981;
  }
  .code-preview {
    background: #020617;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    padding: 10px;
    font-size: 11px;
    font-family: monospace;
    color: #38bdf8;
    margin-bottom: 8px;
  }
</style>
