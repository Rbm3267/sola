    color: #94a3b8;
  }
  .studio-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 700;
    border-radius: 10px;
    cursor: pointer;
    border: none;
    transition: all 0.15s ease;
  }
  .studio-btn-primary {
    background: #10b981;
    color: #090d19;
  }
  .studio-btn-primary:hover {
    background: #059669;
    transform: translateY(-1px);
  }
  .studio-canvas {
    flex: 1;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 32px 24px;
  }
  .studio-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 900px) {
    .studio-grid { grid-template-columns: 1fr; }
    .sola-card.col-2 { grid-column: span 1 !important; }
  }
  .sola-card {
    background: rgba(15, 23, 42, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
