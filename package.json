{
  "name": "sola-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "app", "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild": true,
    "@google/genai": true,
    "protobufjs": true,
    "@rolldown/binding-linux-x64-gnu": true,
    "@rolldown/binding-wasm32-wasi": true
  }
}


