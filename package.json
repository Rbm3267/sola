{
  "name": "sola-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "app",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "test": "node --test packages/core/test/core.test.js packages/core/test/sentinel.test.js && node packages/compiler/test/compiler.test.js",
    "test:e2e": "playwright test"
  },
  "allowScripts": {
    "esbuild": true,
    "@google/genai": true,
    "protobufjs": true,
    "@rolldown/binding-linux-x64-gnu": true,
    "@rolldown/binding-wasm32-wasi": true
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
