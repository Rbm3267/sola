{
  "manifest_version": 3,
  "name": "Sola — View in My UI (In-Situ Preview)",
  "version": "0.9.0",
  "description": "Preview ambient zero-VDOM Sola UI components directly on top of your live web apps in a closed Shadow DOM.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Sola Component Dock"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
