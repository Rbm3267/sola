<script>
  // Accepts either a plain markdown string or a getter function (const content = () =>
  // signal()), mirroring IntentCard/StreamView's convention for live/reactive content.
  export let content = '';

  // {@html}-injected markup bypasses this component's own scoped <style> block entirely —
  // it's raw HTML set via innerHTML at runtime, not DOM nodes the compiler created and
  // hashed, so a scoped `h1 { ... }` rule (or `:global(h1)`, which this compiler doesn't
  // support at all) can never match it. Styling is baked directly into the generated
  // markup as inline styles instead, which works regardless of that limitation.
  var STYLES = {
    h1: 'font-size:26px;font-weight:800;color:#0f172a;letter-spacing:-0.02em;margin:20px 0 10px 0;',
    h2: 'font-size:21px;font-weight:800;color:#0f172a;letter-spacing:-0.02em;margin:20px 0 10px 0;',
    h3: 'font-size:17px;font-weight:800;color:#0f172a;letter-spacing:-0.02em;margin:20px 0 10px 0;',
    p: 'margin:0 0 12px 0;',
    a: 'color:#0ea5e9;text-decoration:none;font-weight:600;',
    code: 'font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:0.9em;background:#f1f5f9;color:#0f172a;padding:2px 6px;border-radius:6px;',
    pre: 'background:#0f172a;color:#f1f5f9;padding:14px 16px;border-radius:12px;overflow-x:auto;margin:0 0 12px 0;',
    preCode: 'background:none;color:inherit;padding:0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;',
    blockquote: 'margin:0 0 12px 0;padding:4px 16px;border-left:3px solid #10b981;color:#64748b;font-style:italic;',
    list: 'margin:0 0 12px 0;padding-left:22px;',
    li: 'margin-bottom:4px;',
    hr: 'border:none;border-top:1px solid #e2e8f0;margin:20px 0;',
  };

  function escapeHtml(str) {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function renderInline(text) {
    var out = escapeHtml(text);
    out = out.replace(/`([^`]+)`/g, '<code style="' + STYLES.code + '">$1</code>');
    out = out.replace(/\*\*([^*]+)\*\*/g, '<strong style="font-weight:800;color:#0f172a;">$1</strong>');
    out = out.replace(/\*([^*]+)\*/g, '<em>$1</em>');
    out = out.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" style="' + STYLES.a + '">$1</a>');
    return out;
  }

  function renderMarkdown(md) {
    var lines = (md || '').split('\n');
    var html = '';
    var listType = null;
    var i = 0;

    function closeList() {
      if (listType) {
        html += '</' + listType + '>';
        listType = null;
      }
    }

    while (i < lines.length) {
      var line = lines[i];

      if (/^```/.test(line)) {
        closeList();
        var codeLines = [];
        i++;
        while (i < lines.length && !/^```/.test(lines[i])) {
          codeLines.push(lines[i]);
          i++;
        }
        html += '<pre style="' + STYLES.pre + '"><code style="' + STYLES.preCode + '">' + escapeHtml(codeLines.join('\n')) + '</code></pre>';
        i++;
        continue;
      }

      if (/^### (.*)/.test(line)) {
        closeList();
        html += '<h3 style="' + STYLES.h3 + '">' + renderInline(line.replace(/^### /, '')) + '</h3>';
        i++;
        continue;
      }

      if (/^## (.*)/.test(line)) {
        closeList();
        html += '<h2 style="' + STYLES.h2 + '">' + renderInline(line.replace(/^## /, '')) + '</h2>';
        i++;
        continue;
      }

      if (/^# (.*)/.test(line)) {
        closeList();
        html += '<h1 style="' + STYLES.h1 + '">' + renderInline(line.replace(/^# /, '')) + '</h1>';
        i++;
        continue;
      }

      if (/^> (.*)/.test(line)) {
        closeList();
        html += '<blockquote style="' + STYLES.blockquote + '">' + renderInline(line.replace(/^>\s?/, '')) + '</blockquote>';
        i++;
        continue;
      }

      if (/^(-{3,}|\*{3,})$/.test(line.trim())) {
        closeList();
        html += '<hr style="' + STYLES.hr + '" />';
        i++;
        continue;
      }

      if (/^[-*] (.*)/.test(line)) {
        if (listType !== 'ul') {
          closeList();
          html += '<ul style="' + STYLES.list + '">';
          listType = 'ul';
        }
        html += '<li style="' + STYLES.li + '">' + renderInline(line.replace(/^[-*] /, '')) + '</li>';
        i++;
        continue;
      }

      if (/^\d+\. (.*)/.test(line)) {
        if (listType !== 'ol') {
          closeList();
          html += '<ol style="' + STYLES.list + '">';
          listType = 'ol';
        }
        html += '<li style="' + STYLES.li + '">' + renderInline(line.replace(/^\d+\. /, '')) + '</li>';
        i++;
        continue;
      }

      if (line.trim() === '') {
        closeList();
        i++;
        continue;
      }

      closeList();
      html += '<p style="' + STYLES.p + '">' + renderInline(line) + '</p>';
      i++;
    }

    closeList();
    return html;
  }

  let renderedHtml = $derived(() => renderMarkdown(typeof content === 'function' ? content() : content));
</script>

<div class="sola-markdown-viewer">
  {@html renderedHtml()}
</div>

<style>
  .sola-markdown-viewer {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 14px;
    line-height: 1.65;
    color: #334155;
    word-wrap: break-word;
  }
</style>
