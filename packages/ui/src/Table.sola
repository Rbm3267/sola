<script>
  // Both columns and rows accept either a plain array or a getter function
  // (const rows = () => signal()), matching StreamView/IntentCard/Modal's convention.
  // Needed because a nested component's props are captured once at mount, not
  // re-evaluated on later signal changes — a getter function is what stays live.
  export let columns = [];
  export let rows = [];
  export let striped = false;
  // Optional (row, index) => void — when provided, rows get a pointer cursor and
  // hover treatment. Common pattern: open a Modal with that row's detail.
  export let onRowClick = null;
  // Was previously left to every consumer to hand-roll via cascade overrides
  // (th/td color, border, hover-background) whenever their own page had a
  // dark mode — real, repeated boilerplate across this codebase's own
  // consumers. Built in now so `dark={darkMode()}` replaces that.
  export let dark = false;

  let resolvedColumns = $derived(() => (typeof columns === 'function' ? columns() : columns));
  let resolvedRows = $derived(() => (typeof rows === 'function' ? rows() : rows));

  function handleRowClick(row, i) {
    if (typeof onRowClick === 'function') {
      onRowClick(row, i);
    }
  }
</script>

<div class="table-wrapper {dark ? 'dark' : ''}">
  <table>
    <thead>
      <tr>
        {#each resolvedColumns() as col}
          <th>{col.label || col}</th>
        {/each}
      </tr>
    </thead>
    <tbody>
      {#each resolvedRows() as row, i}
        <tr class="{typeof onRowClick === 'function' ? 'clickable' : ''}" onclick={() => handleRowClick(row, i)}>
          {#each resolvedColumns() as col}
            <td>{row[col.key || col]}</td>
          {/each}
        </tr>
      {/each}
    </tbody>
  </table>
</div>

<style>
  .table-wrapper {
    overflow-x: auto;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    transition: border-color 0.2s ease;
  }

  .table-wrapper.dark { border-color: rgba(255, 255, 255, 0.08); }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  th {
    text-align: left;
    padding: 12px 16px;
    font-size: 11px;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }

  .table-wrapper.dark th {
    color: #6b7690;
    background: rgba(255, 255, 255, 0.02);
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }

  td {
    padding: 12px 16px;
    color: #334155;
    border-bottom: 1px solid #f1f5f9;
  }

  .table-wrapper.dark td {
    color: #c3cbdc;
    border-bottom-color: rgba(255, 255, 255, 0.06);
    background: transparent;
  }

  tr:last-child td {
    border-bottom: none;
  }

  tr:hover td {
    background: #f8fafc;
  }

  .table-wrapper.dark tr:hover td {
    background: rgba(255, 255, 255, 0.03);
  }

  tr.clickable {
    cursor: pointer;
  }
</style>
