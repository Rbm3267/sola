<script>
  // Accepts either a plain string or a getter function (const content = () => signal()),
  // mirroring IntentCard/IntentList's convention for live/reactive values — resolved fresh
  // on every read so a parent can hand this a signal for genuine streaming content.
  export let content = "";
  export let streaming = true;

  let resolvedContent = $derived(() => (typeof content === 'function' ? content() : content));
</script>

<div class="sola-stream-view">
  <div class="stream-header">
    <div class="stream-badge">
      <span class="pulse-dot"></span>
      <span>AI Stream Engine</span>
    </div>
  </div>
  <div class="stream-content">
    <span>{resolvedContent()}</span>
    {#if streaming}
      <span class="stream-cursor"></span>
    {/if}
  </div>
</div>

<style>
  .sola-stream-view {
    background: #0f172a;
    color: #f8fafc;
    border-radius: 18px;
    padding: 20px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    line-height: 1.6;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }

  .stream-header {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 12px;
  }

  .stream-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    padding: 3px 8px;
    border-radius: 6px;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 6px #38bdf8;
  }

  .stream-content {
    white-space: pre-wrap;
    word-break: break-word;
  }

  .stream-cursor {
    display: inline-block;
    width: 8px;
    height: 15px;
    background: #38bdf8;
    vertical-align: middle;
    margin-left: 2px;
    animation: blink 0.8s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>
