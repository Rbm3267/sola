<script>
  export let label = "Button";
  export let variant = "primary"; // primary | secondary | ghost | destructive | outline
  export let size = "default"; // sm | default | lg
  export let disabled = false;
  export let loading = false;
  export let onClick = null;

  function handleClick() {
    if (disabled || loading) return;
    if (typeof onClick === 'function') {
      onClick();
    }
  }
</script>

<button class="sola-btn sola-btn-{variant} sola-btn-{size}" disabled={disabled || loading} onclick={handleClick}>
  {#if loading}
    <span class="sola-btn-spinner"></span>
  {/if}
  <span>{label}</span>
</button>

<style>
  .sola-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 600;
    border-radius: 12px;
    transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    border: 1px solid transparent;
    font-family: inherit;
    user-select: none;
  }
  .sola-btn:active {
    transform: scale(0.98);
  }
  .sola-btn-default { padding: 10px 18px; font-size: 13px; }
  .sola-btn-sm { padding: 6px 12px; font-size: 11px; }
  .sola-btn-lg { padding: 14px 24px; font-size: 15px; }

  .sola-btn-primary {
    background: var(--sola-color-primary-500, #10b981);
    color: #090d19;
    font-weight: 700;
  }
  .sola-btn-primary:hover { background: var(--sola-color-primary-600, #059669); }

  .sola-btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: var(--sola-color-neutral-50, #f8fafc);
    border-color: rgba(255, 255, 255, 0.1);
  }
  .sola-btn-secondary:hover { background: rgba(255, 255, 255, 0.15); }

  .sola-btn-ghost {
    background: transparent;
    color: var(--sola-text-tertiary, #94a3b8);
  }
  .sola-btn-ghost:hover { color: var(--sola-color-neutral-0, #fff); background: rgba(255, 255, 255, 0.05); }

  .sola-btn-destructive {
    background: #ef4444;
    color: var(--sola-color-neutral-0, #fff);
  }
  .sola-btn-destructive:hover { background: #dc2626; }

  /* Was documented above (line 3) but never implemented — a variant="outline"
     button silently fell through to just the base .sola-btn styles with no
     background/border, rendering as unstyled transparent text. */
  .sola-btn-outline {
    background: transparent;
    color: var(--sola-color-primary-500, #10b981);
    border-color: var(--sola-color-primary-500, #10b981);
  }
  .sola-btn-outline:hover { background: rgba(16, 185, 129, 0.1); }

  .sola-btn-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
