<script>
  import Counter from './Counter.sola';

  let name = $state('World');
  let darkMode = $state(false);
  let todos = $state(['Build compiler', 'Add props', 'Ship framework']);
  let newTodo = $state('');

  let greeting = $derived(() => `Hello, ${name()}!`);

  let dashboardData = $intent("Generate a DataCard showing Monthly Active Users at 84,320 up 12.5%");

  function addTodo() {
    if (newTodo().trim()) {
      todos = [...todos(), newTodo().trim()];
      newTodo = '';
    }
  }

  function removeTodo(index) {
    const current = todos();
    todos = current.filter((_, i) => i !== index);
  }
</script>

<div class="app">
  <h1>{greeting()}</h1>

  <div class="section">
    <h2>Two-Way Binding</h2>
    <input bind:value="name" placeholder="Type your name..." />
    <p>You typed: {name()}</p>
  </div>

  <div class="section">
    <h2>Imported Component (Props)</h2>
    <Counter label="Clicks" />
  </div>

  <div class="section">
    <h2>Conditional Rendering</h2>
    <button on:click={() => { darkMode = !darkMode(); }}>
      Toggle Theme
    </button>
    {#if darkMode()}
      <p class="badge dark">Dark Mode Active</p>
    {:else}
      <p class="badge light">Light Mode Active</p>
    {/if}
  </div>

  <div class="section">
    <h2>Dynamic List</h2>
    <div class="todo-input">
      <input bind:value="newTodo" placeholder="Add a task..." />
      <button on:click={addTodo}>Add</button>
    </div>
    <ul>
      {#each todos() as todo, i}
        <li>
          <span>{todo}</span>
        </li>
      {/each}
    </ul>
  </div>

  <div class="section">
    <h2>Ambient Intent</h2>
    <p class="muted">Resolving from LLM...</p>
    <pre><code>{JSON.stringify(dashboardData(), null, 2)}</code></pre>
  </div>
</div>

<style>
  .app {
    font-family: system-ui, -apple-system, sans-serif;
    max-width: 640px;
    margin: 40px auto;
    padding: 24px;
    color: #1e293b;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 800;
    color: #0ea5e9;
    margin-bottom: 2rem;
  }

  h2 {
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
    margin-bottom: 1rem;
  }

  .section {
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    margin-bottom: 16px;
    background: #ffffff;
  }

  input {
    padding: 10px 16px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-size: 1rem;
    width: 100%;
    box-sizing: border-box;
  }

  input:focus {
    outline: none;
    border-color: #0ea5e9;
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.1);
  }

  button {
    padding: 10px 20px;
    background: #0f172a;
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: background 150ms;
  }

  button:hover {
    background: #1e293b;
  }

  .badge {
    display: inline-block;
    padding: 6px 16px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.875rem;
    margin-top: 8px;
  }

  .badge.dark {
    background: #1e293b;
    color: #e2e8f0;
  }

  .badge.light {
    background: #f0f9ff;
    color: #0ea5e9;
    border: 1px solid #bae6fd;
  }

  .todo-input {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
  }

  .todo-input input {
    flex: 1;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    padding: 12px 16px;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  li:last-child {
    border-bottom: none;
  }

  pre {
    background: #0f172a;
    color: #a5b4fc;
    padding: 16px;
    border-radius: 12px;
    overflow-x: auto;
    font-size: 0.875rem;
  }

  .muted {
    font-size: 0.875rem;
    color: #94a3b8;
  }
</style>
