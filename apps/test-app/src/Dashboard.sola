<script>
  // ── Reactive State ───────────────────────────────────────────────────────────
  let cpuLoad      = $state(72);
  let memUsed      = $state(56);
  let netBw        = $state(41);
  let alertActive  = $state(false);
  let dragging     = $state(false);
  let dialStartY   = $state(0);
  let dialStartVal = $state(0);

  let events = $state([
    { id: 1, node: 'node-01', type: 'CPU spike',   sev: 'warn', ts: '14:02:31' },
    { id: 2, node: 'node-03', type: 'Mem reclaim', sev: 'info', ts: '14:03:11' },
    { id: 3, node: 'node-07', type: 'OOM kill',    sev: 'crit', ts: '14:03:44' },
    { id: 4, node: 'node-02', type: 'Disk flush',  sev: 'info', ts: '14:04:05' },
    { id: 5, node: 'node-05', type: 'Net drop',    sev: 'warn', ts: '14:04:22' },
  ]);

  // ── Derived / Computed ──────────────────────────────────────────────────────
  // cpuStatus: nominal → warning → critical thresholds
  let cpuStatus  = $derived(() => cpuLoad() > 85 ? 'critical' : cpuLoad() > 65 ? 'warning' : 'nominal');

  // systemOk drives the conditional status HUD
  let systemOk   = $derived(() => cpuLoad() < 80 && memUsed() < 80);

  // throughput scaled from raw 0-100 band to MB/s
  let throughput = $derived(() => Math.round(netBw() * 9.4));

  // Arc fill % for conic-gradient gauges.
  // A 270° arc = 75% of 360°, so we map 0-100 → 0-75 for the gradient stop.
  // We start the gradient `from 225deg` (7 o'clock) so the gap lands at the
  // bottom centre — classic speedometer orientation.
  let cpuArc = $derived(() => (cpuLoad() * 0.75).toFixed(1));
  let memArc = $derived(() => (memUsed() * 0.75).toFixed(1));
  let netArc = $derived(() => (netBw() * 0.75).toFixed(1));

  // Dial needle rotation: maps 0-100 → -135° to +135° (270° total sweep)
  let dialDeg = $derived(() => Math.round(cpuLoad() * 2.7 - 135));

  // ── Dial Interaction ────────────────────────────────────────────────────────
  function onDialDown(e) {
    dragging = true;
    dialStartY = e.clientY;
    dialStartVal = cpuLoad();
    e.preventDefault();
  }

  function onMove(e) {
    if (!dragging()) return;
    const delta = dialStartY() - e.clientY;         // drag up → higher value
    const next  = Math.min(100, Math.max(0, Math.round(dialStartVal() + delta * 0.35)));
    cpuLoad     = next;
    alertActive = next > 85;
    // mem tracks cpu loosely so all gauges feel alive
    memUsed = Math.min(100, Math.max(10, Math.round(next * 0.74 + 4)));
  }

  function onUp() {
    dragging = false;
  }

  function onDialKey(e) {
    if (e.key === 'ArrowUp')   cpuLoad = Math.min(100, cpuLoad() + 2);
    if (e.key === 'ArrowDown') cpuLoad = Math.max(0,   cpuLoad() - 2);
    alertActive = cpuLoad() > 85;
  }

  // ── Event Feed ──────────────────────────────────────────────────────────────
  function injectEvent() {
    const nodes = ['node-01','node-02','node-04','node-06','node-09'];
    const types = ['CPU spike','Mem reclaim','Net drop','Disk flush','OOM kill'];
    const sevs  = ['info','warn','crit'];
    const d     = new Date();
    const pad   = n => String(n).padStart(2, '0');
    const entry = {
      id:   Date.now(),
      node: nodes[Math.floor(Math.random() * nodes.length)],
      type: types[Math.floor(Math.random() * types.length)],
      sev:  sevs[Math.floor(Math.random() * sevs.length)],
      ts:   `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`,
    };
    events      = [entry, ...events().slice(0, 7)];
    alertActive = entry.sev === 'crit';
    netBw       = Math.min(100, Math.max(5, Math.round(Math.random() * 80 + 10)));
  }
</script>

<div class="db" on:mousemove={onMove} on:mouseup={onUp}>

  <!-- ── Header / Status HUD ──────────────────────────────────────────────── -->
  <header class="db-header">
    <div class="db-brand">
      <div class="brand-pulse"></div>
      <span class="brand-name">AMBIENT RUNTIME</span>
      <span class="brand-sep">/</span>
      <span class="brand-sub">telemetry</span>
    </div>

    {#if systemOk()}
      <div class="hud hud-ok">
        <span class="hud-dot"></span>
        <span class="hud-label">ALL SYSTEMS NOMINAL</span>
      </div>
    {:else}
      <div class="hud hud-warn">
        <span class="hud-dot hud-dot-pulse"></span>
        <span class="hud-label">ANOMALY DETECTED</span>
      </div>
    {/if}

    <div class="db-ts">
      <span class="ts-label">SESSION</span>
      <span class="ts-val">T+00:00:00</span>
    </div>
  </header>

  <!-- ── KPI Gauge Row ─────────────────────────────────────────────────────── -->
  <div class="gauge-row">

    <div class="gauge-card">
      <div class="gauge-label">CPU LOAD</div>
      <div class="gauge-wrap">
        <!-- background track arc (270° at low opacity) -->
        <div class="gauge-track"></div>
        <!-- reactive progress arc via conic-gradient -->
        <div class="gauge-fill" style="background: conic-gradient(from 225deg, #0ea5e9 {cpuArc()}%, rgba(14,165,233,0.08) {cpuArc()}%);"></div>
        <!-- centre hole with readout -->
        <div class="gauge-hole">
          <span class="gauge-val">{cpuLoad()}</span>
          <span class="gauge-unit">%</span>
        </div>
      </div>
      <div class="gauge-chip gauge-chip-{cpuStatus()}">{cpuStatus()}</div>
    </div>

    <div class="gauge-card">
      <div class="gauge-label">MEMORY</div>
      <div class="gauge-wrap">
        <div class="gauge-track"></div>
        <div class="gauge-fill" style="background: conic-gradient(from 225deg, #8b5cf6 {memArc()}%, rgba(139,92,246,0.08) {memArc()}%);"></div>
        <div class="gauge-hole">
          <span class="gauge-val">{memUsed()}</span>
          <span class="gauge-unit">%</span>
        </div>
      </div>
      <div class="gauge-chip gauge-chip-nominal">nominal</div>
    </div>

    <div class="gauge-card">
      <div class="gauge-label">NETWORK</div>
      <div class="gauge-wrap">
        <div class="gauge-track"></div>
        <div class="gauge-fill" style="background: conic-gradient(from 225deg, #10b981 {netArc()}%, rgba(16,185,129,0.08) {netArc()}%);"></div>
        <div class="gauge-hole">
          <span class="gauge-val">{throughput()}</span>
          <span class="gauge-unit">MB/s</span>
        </div>
      </div>
      <div class="gauge-chip gauge-chip-nominal">nominal</div>
    </div>

  </div>

  <!-- ── Haptic Dial Controller ────────────────────────────────────────────── -->
  <div class="dial-section">

    <div class="dial-meta">
      <div class="dial-title">CPU LOAD CONTROLLER</div>
      <div class="dial-hint">drag vertically  ·  arrow keys</div>
    </div>

    <div
      class="dial-knob {dragging() ? 'dial-active' : ''}"
      on:mousedown={onDialDown}
      on:keydown={onDialKey}
      tabindex="0"
    >
      <!-- outer ring ticks (decorative) -->
      <div class="dial-ring">
        <div class="tick tick-0"></div>
        <div class="tick tick-1"></div>
        <div class="tick tick-2"></div>
        <div class="tick tick-3"></div>
        <div class="tick tick-4"></div>
        <div class="tick tick-5"></div>
      </div>
      <!-- rotating face with position marker -->
      <div class="dial-face" style="transform: rotate({dialDeg()}deg);">
        <div class="dial-marker"></div>
      </div>
      <!-- centre readout -->
      <div class="dial-centre">
        <span class="dial-num">{cpuLoad()}</span>
        <span class="dial-pct">%</span>
      </div>
    </div>

    <div class="dial-scale">
      <span>0</span><span>25</span><span>50</span><span>75</span><span>100</span>
    </div>

    {#if alertActive()}
      <div class="dial-alert">
        HIGH LOAD — THROTTLE RECOMMENDED
      </div>
    {:else}
      <div class="dial-ok">
        load within safe operating range
      </div>
    {/if}

  </div>

  <!-- ── Telemetry Event Feed ──────────────────────────────────────────────── -->
  <div class="feed-section">

    <div class="feed-header">
      <span class="feed-title">TELEMETRY EVENTS</span>
      <button class="feed-btn" on:click={injectEvent}>+ INJECT EVENT</button>
    </div>

    <div class="feed-list">
      {#each events() as ev, i}
        <div class="feed-row">
          <span class="sev-badge sev-{ev.sev}">{ev.sev}</span>
          <span class="feed-node">{ev.node}</span>
          <span class="feed-type">{ev.type}</span>
          <span class="feed-ts">{ev.ts}</span>
        </div>
      {/each}
    </div>

  </div>

</div>

<style>
  /* ── Reset / Base ─────────────────────────────────────────────────────── */
  .db {
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    background: #080d18;
    min-height: 100vh;
    padding: 28px 32px 48px;
    color: #e2e8f0;
    user-select: none;
    box-sizing: border-box;
  }

  /* ── Header ─────────────────────────────────────────────────────────── */
  .db-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 36px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .db-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
  }

  .brand-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #0ea5e9;
    box-shadow: 0 0 8px #0ea5e9;
    animation: breathe 2.4s ease-in-out infinite;
  }

  .brand-name {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #f1f5f9;
  }

  .brand-sep {
    color: rgba(255, 255, 255, 0.2);
    font-size: 13px;
  }

  .brand-sub {
    font-size: 11px;
    color: #64748b;
    letter-spacing: 0.08em;
  }

  /* ── Status HUD ─────────────────────────────────────────────────────── */
  .hud {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    border: 1px solid;
  }

  .hud-ok {
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.3);
    color: #34d399;
  }

  .hud-warn {
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.35);
    color: #f87171;
  }

  .hud-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .hud-dot-pulse {
    animation: blip 0.9s ease-in-out infinite;
  }

  .db-ts {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .ts-label {
    font-size: 9px;
    color: #475569;
    letter-spacing: 0.12em;
  }

  .ts-val {
    font-size: 12px;
    color: #64748b;
  }

  /* ── Gauge Row ──────────────────────────────────────────────────────── */
  .gauge-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 28px;
  }

  .gauge-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 20px;
    padding: 24px 20px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    transition: border-color 0.2s;
  }

  .gauge-card:hover {
    border-color: rgba(255, 255, 255, 0.14);
  }

  .gauge-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #475569;
    align-self: flex-start;
  }

  /* The gauge ring: three stacked absolute layers inside a 130×130 box */
  .gauge-wrap {
    position: relative;
    width: 130px;
    height: 130px;
    border-radius: 50%;
  }

  /* Static 270° background track using conic-gradient */
  .gauge-track {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 225deg,
      rgba(100, 116, 139, 0.18) 0% 75%,
      transparent 75%
    );
  }

  /* Dynamic progress arc (background set inline via reactive style attr) */
  .gauge-fill {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    transition: background 60ms linear;
  }

  /* Inner donut hole — hides the centre of the conic-gradient ring */
  .gauge-hole {
    position: absolute;
    top: 16px;
    left: 16px;
    right: 16px;
    bottom: 16px;
    border-radius: 50%;
    background: #080d18;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
  }

  .gauge-val {
    font-size: 26px;
    font-weight: 800;
    color: #f1f5f9;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .gauge-unit {
    font-size: 9px;
    color: #475569;
    letter-spacing: 0.1em;
    margin-top: 2px;
  }

  .gauge-chip {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid;
    text-transform: uppercase;
  }

  .gauge-chip-nominal {
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.25);
    color: #34d399;
  }

  .gauge-chip-warning {
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.35);
    color: #fbbf24;
  }

  .gauge-chip-critical {
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.35);
    color: #f87171;
    animation: blip 0.8s ease-in-out infinite;
  }

  /* ── Dial Section ───────────────────────────────────────────────────── */
  .dial-section {
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 20px;
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
  }

  .dial-meta {
    text-align: center;
  }

  .dial-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #94a3b8;
    margin-bottom: 4px;
  }

  .dial-hint {
    font-size: 10px;
    color: #334155;
    letter-spacing: 0.08em;
  }

  /* The interactive dial knob */
  .dial-knob {
    position: relative;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 35%, #1e2d45, #0c1525);
    border: 2px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      0 0 0 6px rgba(14, 165, 233, 0.06),
      0 8px 32px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    cursor: ns-resize;
    outline: none;
    transition: box-shadow 0.15s, border-color 0.15s;
  }

  .dial-knob:focus {
    border-color: rgba(14, 165, 233, 0.5);
    box-shadow:
      0 0 0 6px rgba(14, 165, 233, 0.12),
      0 8px 32px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .dial-active {
    border-color: rgba(14, 165, 233, 0.6);
    box-shadow:
      0 0 0 8px rgba(14, 165, 233, 0.15),
      0 0 40px rgba(14, 165, 233, 0.2),
      0 8px 32px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  /* Outer tick ring (purely decorative, CSS-positioned) */
  .dial-ring {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    pointer-events: none;
  }

  .tick {
    position: absolute;
    width: 3px;
    height: 8px;
    background: rgba(100, 116, 139, 0.35);
    border-radius: 2px;
    left: 50%;
    top: 0;
    transform-origin: 50% 90px;
  }

  .tick-0 { transform: translateX(-50%) rotate(0deg); }
  .tick-1 { transform: translateX(-50%) rotate(54deg); }
  .tick-2 { transform: translateX(-50%) rotate(108deg); }
  .tick-3 { transform: translateX(-50%) rotate(162deg); }
  .tick-4 { transform: translateX(-50%) rotate(216deg); }
  .tick-5 { transform: translateX(-50%) rotate(270deg); }

  /* Rotating face with position marker dot */
  .dial-face {
    position: absolute;
    inset: 10px;
    border-radius: 50%;
    transition: transform 40ms linear;
  }

  .dial-marker {
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0ea5e9;
    box-shadow: 0 0 8px #0ea5e9, 0 0 20px rgba(14, 165, 233, 0.4);
  }

  /* Centre readout */
  .dial-centre {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1px;
    pointer-events: none;
  }

  .dial-num {
    font-size: 34px;
    font-weight: 900;
    color: #f1f5f9;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .dial-pct {
    font-size: 14px;
    color: #475569;
    align-self: flex-end;
    padding-bottom: 5px;
  }

  /* Scale labels */
  .dial-scale {
    display: flex;
    justify-content: space-between;
    width: 200px;
    font-size: 9px;
    color: #334155;
    letter-spacing: 0.1em;
  }

  /* Alert/OK status line below dial */
  .dial-alert {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #f87171;
    padding: 6px 16px;
    border-radius: 999px;
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.3);
    animation: blip 0.9s ease-in-out infinite;
  }

  .dial-ok {
    font-size: 10px;
    color: #334155;
    letter-spacing: 0.1em;
  }

  /* ── Event Feed ─────────────────────────────────────────────────────── */
  .feed-section {
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 20px;
    overflow: hidden;
  }

  .feed-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .feed-title {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #475569;
  }

  .feed-btn {
    font-family: inherit;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 6px 14px;
    border-radius: 8px;
    border: 1px solid rgba(14, 165, 233, 0.35);
    background: rgba(14, 165, 233, 0.08);
    color: #38bdf8;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }

  .feed-btn:hover {
    background: rgba(14, 165, 233, 0.16);
    border-color: rgba(14, 165, 233, 0.6);
  }

  .feed-list {
    padding: 8px 0;
  }

  .feed-row {
    display: grid;
    grid-template-columns: 56px 80px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 10px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    transition: background 0.12s;
  }

  .feed-row:last-child {
    border-bottom: none;
  }

  .feed-row:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  /* Severity badges */
  .sev-badge {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 4px;
    text-align: center;
  }

  .sev-info {
    background: rgba(14, 165, 233, 0.12);
    color: #38bdf8;
    border: 1px solid rgba(14, 165, 233, 0.25);
  }

  .sev-warn {
    background: rgba(245, 158, 11, 0.12);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .sev-crit {
    background: rgba(239, 68, 68, 0.12);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .feed-node {
    font-size: 11px;
    font-weight: 600;
    color: #64748b;
    letter-spacing: 0.06em;
  }

  .feed-type {
    font-size: 11px;
    color: #94a3b8;
  }

  .feed-ts {
    font-size: 10px;
    color: #334155;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  /* ── Animations ─────────────────────────────────────────────────────── */
  @keyframes breathe {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.35; }
  }

  @keyframes blip {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.3; }
  }
</style>
